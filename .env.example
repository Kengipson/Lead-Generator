# Get your token from https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Actor that scrapes Google Maps. The default is the popular "Google Maps Scraper"
# actor by compass (id: compass/crawler-google-places). Override if you use a
# different actor.
APIFY_ACTOR_ID=compass/crawler-google-places
