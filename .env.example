# Get your token from https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Actor that scrapes Google Maps. The default is the popular "Google Maps Scraper"
# actor by compass (id: compass/crawler-google-places). Override if you use a
# different actor.
APIFY_ACTOR_ID=compass/crawler-google-places

# Optional: path to an outreach-tracker .xlsx (must have an "Outreach Tracker"
# sheet) to auto-append new leads into. Leave unset to skip this step, or
# override per-run with --tracker-path / skip with --skip-tracker.
OUTREACH_TRACKER_PATH=

# Optional: path to a Google OAuth "installed app" credentials.json (from
# https://console.cloud.google.com/apis/credentials, Gmail API enabled) to
# auto-create a Gmail draft for each new lead. Leave unset to skip this step,
# or override per-run with --gmail-credentials-path / skip with --skip-drafts.
# NEVER commit credentials.json or the token it produces -- both are
# gitignored already, keep it that way.
GMAIL_CREDENTIALS_PATH=

# Optional: where to cache the Gmail OAuth token after the first browser
# authorization (default: token.json next to main.py).
GMAIL_TOKEN_PATH=
